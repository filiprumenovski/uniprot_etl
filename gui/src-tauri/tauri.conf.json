{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UniProt ETL",
  "version": "0.1.0",
  "identifier": "com.uniprot.etl",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../frontend"
    },
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../frontend"
    },
    "frontendDist": "../frontend/out"
  },
  "app": {
    "windows": [
      {
        "title": "UniProt ETL",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
